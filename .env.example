# ==========================================================
# Jev AI Binance ARB/USDT Trading Bot Configuration
# ==========================================================

# 1. Jev AI Configuration (from https://jevai.org / https://typesafe.ai)
# Get key from https://console.typesafe.ai or via OpenRouter
JEV_API_KEY=
JEV_API_ENDPOINT=https://api.typesafe.ai/v1/systemone
# Model name: jev-1 (official) or typesafe-ai/jev (OpenRouter / Vercel AI Gateway)
JEV_MODEL=jev-1
# Fallback to local high-precision Jev Decision Emulator if no API key is provided
JEV_ENABLE_EMULATOR_FALLBACK=true

# 2. Binance API Configuration
# Leave empty for Paper Trading simulation mode
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Options: SPOT or FUTURES
BINANCE_MARKET_TYPE=SPOT
# Set to true to connect to Binance Spot/Futures Testnet
BINANCE_TESTNET=false

# 3. Trading & Execution Settings
# Target trading pair
SYMBOL=ARB/USDT
# Trading Mode: PAPER (Simulation) or LIVE (Real funds)
TRADING_MODE=PAPER
# Initial virtual balance for Paper Trading (in USDT)
PAPER_INITIAL_BALANCE=1000.0

# 4. Risk Guardian Settings
# Maximum risk percentage of total portfolio per trade (1.5 = 1.5%)
RISK_PER_TRADE_PERCENT=1.5
# Minimum Jev AI confidence score required to trigger execution (0-100)
MIN_JEV_CONFIDENCE=75
# Stop Loss ATR multiplier (e.g. 1.5 x ATR)
ATR_SL_MULTIPLIER=1.8
# Take Profit ATR multiplier (e.g. 3.0 x ATR -> 1:1.66 R:R)
ATR_TP_MULTIPLIER=3.0
# Daily Maximum Drawdown Limit percentage (circuit breaker will halt bot)
MAX_DAILY_DRAWDOWN_PERCENT=5.0
# Enable trailing stop loss to protect profits
TRAILING_STOP_ENABLED=true
TRAILING_STOP_CALLBACK_PERCENT=0.8

# 5. Web Terminal Dashboard
WEB_HOST=127.0.0.1
WEB_PORT=8080
